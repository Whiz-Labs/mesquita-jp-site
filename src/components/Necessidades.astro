---
/**
 * O que a comunidade precisa comprar, consertar ou manter.
 *
 * Página separada da prestação de contas de propósito: são duas conversas
 * diferentes. As contas dizem "isto foi feito com o que você deu"; as
 * necessidades dizem "isto ainda falta". Juntas numa página só, uma delas
 * sempre vira rodapé da outra.
 *
 * Duas naturezas na mesma lista, e a diferença é visível:
 *
 *   ALVO       — junta-se o dinheiro, compra-se, sai da lista. Tem barra de
 *                progresso, porque há um fim para o qual progredir.
 *   RECORRENTE — energia, água, limpeza. Não acaba: renasce todo mês. Não tem
 *                barra, porque progresso em direção a quê? Mostra o custo do
 *                período e pronto.
 *
 * Lista, e não grade de cartões: a ordem é informação — a tesouraria define a
 * prioridade, e uma grade de três colunas embaralha isso na leitura.
 *
 * Só aparece o que a tesouraria marcou como "no site"; quem filtra é o RLS.
 */
import Icon from './Icon.astro';
import { canalPrincipal } from '../config';
import { formatarCentavos, lerNecessidades } from '../lib/transparencia';

const necessidades = await lerNecessidades();

/** Dois rótulos por período: o do selo e o que acompanha o valor. */
const PERIODO: Record<string, { selo: string; unidade: string }> = {
  semanal: { selo: 'toda semana', unidade: 'por semana' },
  mensal: { selo: 'todo mês', unidade: 'por mês' },
};
---

<section id="necessidades" class="nec-sec">
  <div class="container">
    {/* Mesmo bloco da página de contas: as duas são documentos da mesma
        tesouraria, e ler uma depois da outra não deve parecer trocar de site.
        Ali o assunto é um número; aqui é o pedido, então o título é que ocupa
        o lugar dele. */}
    <header class="painel">
      <p class="quem">Necessidades · Centro Islâmico de João Pessoa</p>
      <h2>O que a comunidade precisa</h2>
      <p class="ressalva">
        Em ordem de urgência, como a tesouraria definiu. Quando uma é concluída, sai daqui.
      </p>
      <button type="button" class="imprimir nao-imprime" onclick="window.print()">
        <Icon name="printer" size={17} />
        Imprimir · salvar em PDF
      </button>
    </header>

    {
      necessidades.length === 0 ? (
        <div class="vazio">
          <p>
            <strong>Nada na lista agora.</strong> Quando houver algo que a comunidade precise
            comprar ou consertar, aparece aqui. Para ajudar de outra forma, fale com a
            administração pelo {canalPrincipal.nome}.
          </p>
          <a href={canalPrincipal.href} class="btn btn-secondary" target="_blank" rel="noopener">
            <Icon name={canalPrincipal.icon} size={18} /> {canalPrincipal.acao}
          </a>
        </div>
      ) : (
        <>
          <ol class="lista">
            {necessidades.map((n) => {
              const recorrente = n.periodicidade !== null;
              const pct =
                !recorrente && n.meta_centavos
                  ? Math.min(100, Math.round((n.arrecadado_centavos / n.meta_centavos) * 100))
                  : null;
              /* Chegar à meta é o momento que a lista existe para produzir, e
                 até agora 100% e 40% tinham a mesma cara. O que falta é o outro
                 número que importa: é ele que diz a quem lê o que fazer. */
              const alcancada = pct !== null && n.arrecadado_centavos >= (n.meta_centavos ?? 0);
              const falta = Math.max(0, (n.meta_centavos ?? 0) - n.arrecadado_centavos);
              return (
                <li class:list={['item', { recorrente, alcancada }]}>
                  <div class="cabeca">
                    <h3>
                      {n.titulo}
                      {recorrente && (
                        <span class="ciclo">{PERIODO[n.periodicidade as string].selo}</span>
                      )}
                      {alcancada && (
                        <span class="conseguimos">
                          <Icon name="check" size={14} /> Conseguimos
                        </span>
                      )}
                    </h3>

                    <p class="cifra">
                      {recorrente ? (
                        n.meta_centavos ? (
                          <>
                            {/* "cerca de" e não "~": quem lê a página não é
                                obrigado a conhecer o símbolo. */}
                            {n.valor_aproximado && <span class="por">cerca de</span>}
                            <strong>{formatarCentavos(n.meta_centavos)}</strong>
                            <span class="por">{PERIODO[n.periodicidade as string].unidade}</span>
                          </>
                        ) : (
                          <span class="por">valor que muda a cada período</span>
                        )
                      ) : n.meta_centavos ? (
                        <>
                          <strong>{formatarCentavos(n.arrecadado_centavos)}</strong>
                          <span class="por">
                            de {n.valor_aproximado && 'cerca de '}
                            {formatarCentavos(n.meta_centavos)}
                          </span>
                        </>
                      ) : (
                        <>
                          <strong>{formatarCentavos(n.arrecadado_centavos)}</strong>
                          <span class="por">arrecadados</span>
                        </>
                      )}
                    </p>
                  </div>

                  {n.descricao && <p class="desc">{n.descricao}</p>}

                  {
                    pct !== null && (
                      <div class="linha-progresso">
                        <div class="barra">
                          <i style={`width:${pct}%`} />
                        </div>
                        <span class="pct">
                          {alcancada ? 'meta alcançada' : `faltam ${formatarCentavos(falta)}`}
                        </span>
                      </div>
                    )
                  }
                </li>
              );
            })}
          </ol>

          <a href={canalPrincipal.href} class="btn btn-primary nao-imprime" target="_blank" rel="noopener">
            <Icon name="heart" size={18} /> Quero ajudar
          </a>
        </>
      )
    }
  </div>
</section>

<style>
  /* Mesmo dimensionamento da página de contas: isto é documento, não chamada. */
  .nec-sec {
    background: var(--areia-escura);
    padding-block: 2.25rem 4rem;
    min-height: 60vh;
  }

  .painel {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1.4rem 1.6rem 1.5rem;
    margin-bottom: 1.25rem;
    background: var(--verde);
    color: var(--branco);
    border-radius: 18px;
  }

  .quem {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .painel h2 {
    margin: 0;
    font-size: clamp(1.6rem, 4.5vw, 2.3rem);
    line-height: 1.1;
  }

  .ressalva {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.78);
    max-width: 54ch;
  }

  .imprimir {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: start;
    margin-top: 1.1rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 10px;
    background: transparent;
    color: rgba(255, 255, 255, 0.9);
    cursor: pointer;
  }

  .imprimir:hover {
    border-color: var(--dourado-claro);
    color: var(--dourado-claro);
  }

  .vazio {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 1.25rem;
    max-width: 42rem;
  }

  .vazio p {
    margin: 0;
    color: var(--texto-suave);
  }

  /* `ol` e não `ul`: a ordem é a prioridade que a tesouraria definiu, e isso é
     conteúdo. O número em si não aparece — quem lê não precisa de "1., 2., 3."
     para entender que o de cima vem primeiro. */
  .lista {
    list-style: none;
    margin: 0 0 1.75rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.35rem;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-left: 4px solid var(--verde-claro);
    border-radius: 4px 14px 14px 4px;
  }

  /* Despesa que volta sempre não é urgência: a faixa dourada a distingue do
     que tem fim, sem precisar de legenda. */
  .item.recorrente {
    border-left-color: var(--dourado);
  }

  /* Alcançada: a faixa e a barra viram douradas, e o cartão ganha um fundo
     de leve. Sóbrio de propósito — é uma casa de oração prestando contas, não
     uma campanha. O que muda é o suficiente para o olho parar ali. */
  .item.alcancada {
    border-left-color: var(--dourado-escuro);
    background: linear-gradient(180deg, #fbf7e9, var(--branco) 70%);
  }

  .conseguimos {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.12rem 0.5rem 0.12rem 0.4rem;
    border-radius: 999px;
    background: var(--dourado-escuro);
    color: var(--branco);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .cabeca {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  h3 {
    margin: 0;
    font-size: 1.05rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .ciclo {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--areia-escura);
    color: var(--dourado-escuro);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .cifra {
    margin: 0;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .cifra strong {
    font-size: 1.05rem;
  }

  .por:first-child {
    margin-right: 0.3rem;
    margin-left: 0;
  }

  .por {
    margin-left: 0.3rem;
    font-size: 0.85rem;
    color: var(--texto-suave);
  }

  .desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--texto-suave);
    max-width: 68ch;
  }

  .linha-progresso {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.15rem;
  }

  .barra {
    flex: 1;
    height: 8px;
    border-radius: 999px;
    background: var(--areia-escura);
    overflow: hidden;
  }

  .barra i {
    display: block;
    height: 100%;
    background: var(--verde-claro);
    border-radius: 999px;
  }

  .item.alcancada .barra i {
    background: linear-gradient(90deg, var(--dourado), var(--dourado-escuro));
  }

  .pct {
    font-size: 0.78rem;
    color: var(--texto-suave);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .item.alcancada .pct {
    color: var(--dourado-escuro);
    font-weight: 600;
  }

  @media (max-width: 46rem) {
    .painel {
      padding: 1.2rem 1.15rem 1.3rem;
    }

    .imprimir {
      align-self: stretch;
      justify-content: center;
    }

    .cabeca {
      flex-direction: column;
      gap: 0.15rem;
    }

    .cifra {
      white-space: normal;
    }
  }

  @media print {
    .painel {
      background: #fff !important;
      color: #000;
      border: 2px solid #000;
      padding: 0.8rem 1rem;
      margin-bottom: 1rem;
    }

    .quem,
    .ressalva {
      color: #333;
    }

    .quem::after {
      content: ' · centroislamicojp.org.br/necessidades';
    }

    /* No papel o fundo e o dourado somem; o selo continua legível em preto. */
    .item.alcancada {
      background: #fff !important;
    }

    .conseguimos {
      background: #fff !important;
      color: #000;
      border: 1px solid #000;
    }

    .item {
      break-inside: avoid;
      border: 1px solid #999;
      border-left: 4px solid #666;
      padding: 0.6rem 0.8rem;
    }

    .barra {
      border: 1px solid #999;
    }

    .barra i {
      background: #666;
    }
  }
</style>
