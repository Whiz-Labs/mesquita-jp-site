---
import Icon from './Icon.astro';
import { books, requestForm, canalPrincipal } from '../config';

// Formulário único para três assuntos. A troca dos campos é feita só com CSS:
// os três radios ficam como filhos diretos do <form>, escondidos, e cada bloco
// condicional é irmão deles — `#tipo-x:checked ~ .campos .so-x { display: grid }`.
// Sem JavaScript para trocar os campos; o único script (no fim) só enxuga o
// envio, e o formulário funciona antes de ele carregar.
//
// Envio por Netlify Forms. Regras que não dá para quebrar:
//  - o <input name="form-name"> precisa bater com o `name` do <form>;
//  - nenhum campo condicional pode ser `required` — o navegador se recusa a
//    enviar quando um campo obrigatório está escondido;
//  - o honeypot (`bot-field`) é o filtro de spam, e fica fora da vista.
const { name: formName, successPage, types } = requestForm;
---

<section id="pedidos" class="section pedidos">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Livros e pedidos</span>
      <h2>Peça livros islâmicos ou marque uma visita</h2>
      <p>
        Enviamos livros sobre o Islam para quem mora no {books.regionLabel}, conforme a
        disponibilidade. O mesmo formulário serve para agendar uma visita à mesquita, para
        quem quer abraçar o Islam e fazer a shahada, para deixar uma opinião ou sugestão, ou
        tratar de qualquer outro assunto com a administração.
      </p>
    </div>

    <div class="ped-grid">
      <aside class="ped-info">
        <h3>Como funciona o envio</h3>
        <ol>
          <li>Você escolhe “{types[0].label}” e preenche o endereço.</li>
          <li>A gente confere o pedido e responde pelo contato que você deixar.</li>
          <li>Havendo o livro em estoque, ele é postado para o seu endereço.</li>
        </ol>
        <p class="ped-note">{books.note}</p>

        <h3 class="ped-h3">Estados atendidos</h3>
        <ul class="ped-estados">
          {books.states.map((uf) => <li>{uf}</li>)}
        </ul>

        <p class="ped-note">
          Mora fora do {books.regionLabel}? Escreva mesmo assim pelo {canalPrincipal.nome} —
          a gente tenta indicar alguém mais perto de você.
        </p>
      </aside>

      <form
        class="form"
        name={formName}
        method="POST"
        action={successPage}
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <!-- Netlify: identifica o formulário no painel. -->
        <input type="hidden" name="form-name" value={formName} />

        <!-- Honeypot: humano nenhum vê este campo; robô preenche e é descartado. -->
        <p class="honeypot">
          <label>Não preencha este campo: <input name="bot-field" tabindex="-1" /></label>
        </p>

        <p class="form-pergunta" id="pergunta-assunto">O que você precisa?</p>

        {/*
          O <label> escondido antes de cada radio é para a Netlify, não para
          gente: o e-mail de aviso nomeia cada campo pelo primeiro <label> que
          aponta para ele, e sem este o grupo aparecia com o texto do primeiro
          cartão ("Quero receber livros islâmicos Envio para o Nordeste: Outro
          assunto"). O leitor de tela lê os dois rótulos, "Assunto" e o cartão.
        */}
        {
          types.map((t, i) => (
            <>
              <label for={`tipo-${t.id}`} class="visually-hidden">Assunto</label>
              <input
                class="tipo-radio visually-hidden"
                type="radio"
                name="assunto"
                id={`tipo-${t.id}`}
                value={t.value}
                checked={i === 0}
                aria-describedby="pergunta-assunto"
              />
            </>
          ))
        }

        {/*
          Como recebe. Mesma mecânica dos radios de assunto: filhos diretos do
          <form>, e os campos de endereço aparecem só no correio. O padrão é o
          correio porque é para isso que este formulário existe — quem mora
          longe. A retirada está aqui para que quem é de João Pessoa não gere
          uma postagem que não precisava existir.
        */}
        <label for="entrega-correio" class="visually-hidden">Como prefere receber</label>
        <input class="entrega-radio visually-hidden" type="radio" name="entrega" id="entrega-correio"
               value="Receber pelo correio" checked />
        <label for="entrega-retirar" class="visually-hidden">Como prefere receber</label>
        <input class="entrega-radio visually-hidden" type="radio" name="entrega" id="entrega-retirar"
               value="Retirar na mesquita" />

        {/*
          Shahada: já fez, ou quer fazer. Também filhos diretos do <form>, pela
          mesma razão dos radios de entrega. Sem `checked` de propósito — as
          duas respostas são igualmente prováveis, e um padrão aqui poria
          palavras na boca de quem não escolheu.
        */}
        <label for="shahada-fazer" class="visually-hidden">Shahada</label>
        <input class="visually-hidden" type="radio" name="shahada" id="shahada-fazer"
               value="Quero fazer a shahada na mesquita" />
        <label for="shahada-feita" class="visually-hidden">Shahada</label>
        <input class="visually-hidden" type="radio" name="shahada" id="shahada-feita"
               value="Já fiz a shahada e quero a declaração" />

        {/* Onde fez a shahada: aqui ou em outro lugar. Mesma mecânica. */}
        <label for="onde-centro" class="visually-hidden">Onde fez a shahada</label>
        <input class="visually-hidden" type="radio" name="shahada_onde" id="onde-centro"
               value="No Centro Islâmico de João Pessoa" />
        <label for="onde-outro" class="visually-hidden">Onde fez a shahada</label>
        <input class="visually-hidden" type="radio" name="shahada_onde" id="onde-outro"
               value="Em outro lugar" />

        <div class="tipo-grid">
          {
            types.map((t) => (
              <label for={`tipo-${t.id}`} class="tipo-card">
                <Icon name={t.icon} size={20} />
                <span>
                  <strong>{t.label}</strong>
                  <small>{t.hint}</small>
                </span>
              </label>
            ))
          }
        </div>

        <div class="campos">
          <!-- Comuns a todos os assuntos -->
          <div class="campo">
            <label for="f-nome">Nome completo</label>
            <input type="text" id="f-nome" name="nome" required autocomplete="name" />
          </div>

          <div class="campo">
            <label for="f-contato">E-mail, telefone ou @ do Instagram</label>
            <input
              type="text"
              id="f-contato"
              name="contato"
              required
              placeholder="para a gente conseguir te responder"
            />
          </div>

          <!-- Só para o pedido de livros -->
          <div class="so-livros campo campo--largo entrega-escolha">
            <span class="rotulo-grupo">Como prefere receber</span>
            <div class="entrega-opcoes">
              <label for="entrega-correio">Pelo correio</label>
              <label for="entrega-retirar">Retirar na mesquita</label>
            </div>
            <small>Se você é de João Pessoa, retirar é mais rápido — e a gente se conhece.</small>
          </div>

          {/* Uma linha, e nada de dado pessoal a mais. Não é um teste: é o que
              nos ajuda a escolher o livro certo, e de quebra separa o pedido
              pensado do clique distraído. */}
          <div class="so-livros campo campo--largo">
            <label for="f-motivo">Por que quer o livro?</label>
            <input
              type="text"
              id="f-motivo"
              name="motivo"
              maxlength="200"
              placeholder="uma linha basta — ajuda a escolher o que enviar"
            />
          </div>

          <div class="so-livros so-correio campo">
            <label for="f-estado">Estado</label>
            <select id="f-estado" name="estado">
              <option value="">Selecione…</option>
              {books.states.map((uf) => <option value={uf}>{uf}</option>)}
              <option value="Fora do Nordeste">Moro fora do Nordeste</option>
            </select>
          </div>

          <div class="so-livros so-correio campo">
            <label for="f-cidade">Cidade</label>
            <input type="text" id="f-cidade" name="cidade" autocomplete="address-level2" />
          </div>

          <div class="so-livros so-correio campo campo--largo">
            <label for="f-endereco">Endereço completo para envio</label>
            <input
              type="text"
              id="f-endereco"
              name="endereco"
              placeholder="rua, número, complemento, bairro e CEP"
              autocomplete="street-address"
            />
          </div>

          <!-- Só para a visita -->
          <div class="so-visita campo">
            <label for="f-pessoas">Quantas pessoas</label>
            <input type="number" id="f-pessoas" name="pessoas" min="1" placeholder="1" />
          </div>

          <div class="so-visita campo">
            <label for="f-quando">Dia pretendido</label>
            <input type="date" id="f-quando" name="quando" />
          </div>

          <div class="so-visita campo campo--largo">
            <p class="campo-aviso">
              <Icon name="info" size={16} />
              A mesquita abre sexta e sábado, das 11h30 às 13h00. Para outro dia, diga na
              mensagem — a gente vê o que dá para combinar.
            </p>
          </div>

          <!-- Só para a shahada -->
          <div class="so-shahada campo campo--largo entrega-escolha">
            <span class="rotulo-grupo">Qual é o seu caso?</span>
            <div class="entrega-opcoes">
              <label for="shahada-fazer">Quero fazer a shahada</label>
              <label for="shahada-feita">Já fiz, quero a declaração</label>
            </div>
          </div>

          {/* O que vai impresso na declaração, e só isso. O painel da
              administração recebe estes campos já separados e imprime a
              declaração a partir deles — por isso o nome tem de ser o do
              documento, e não o apelido. */}
          <div class="so-shahada campo campo--largo">
            <p class="campo-nota">
              O nome acima sai impresso na declaração: escreva como consta no seu documento.
            </p>
          </div>

          <div class="so-shahada campo">
            <label for="f-nome-islamico">Nome islâmico, se adotou um</label>
            <input
              type="text"
              id="f-nome-islamico"
              name="nome_islamico"
              maxlength="120"
              placeholder="opcional"
            />
          </div>

          {/* Só quando a shahada já foi feita: a declaração registra o dia e o
              lugar. Quem vai fazer na mesquita não tem data ainda — ela é
              combinada depois. */}
          <div class="so-shahada so-feita campo">
            <label for="f-shahada-data">Dia em que fez a shahada</label>
            <input type="date" id="f-shahada-data" name="shahada_data" />
          </div>

          <div class="so-shahada so-feita campo campo--largo entrega-escolha">
            <span class="rotulo-grupo">Onde fez a shahada</span>
            <div class="entrega-opcoes">
              <label for="onde-centro">No Centro Islâmico de João Pessoa</label>
              <label for="onde-outro">Em outro lugar</label>
            </div>
          </div>

          {/* O campo livre só para "outro lugar". No webhook do painel, este
              texto substitui o valor do radio na coluna `shahada_onde`. */}
          <div class="so-shahada so-feita so-onde-outro campo campo--largo">
            <label for="f-shahada-onde-outro">Qual lugar</label>
            <input
              type="text"
              id="f-shahada-onde-outro"
              name="shahada_onde_outro"
              maxlength="200"
              placeholder="cidade, mesquita ou diante de quem"
            />
          </div>

          <div class="so-shahada campo campo--largo">
            <p class="campo-aviso">
              <Icon name="info" size={16} />
              Ninguém precisa de documento para ser muçulmano — a declaração é para quem
              quiser tê-la. Ela é impressa pela administração, carimbada e assinada pelo imam
              e por testemunhas, e entregue na mesquita. A gente combina o dia pelo contato
              que você deixar.
            </p>
          </div>

          <!-- Só para outro assunto -->
          <div class="so-outro campo campo--largo">
            <label for="f-titulo">Assunto</label>
            <input
              type="text"
              id="f-titulo"
              name="titulo"
              placeholder="em poucas palavras, do que se trata"
            />
          </div>

          <!-- Comum de novo. Obrigatória, menos na shahada: lá tudo o que a
               declaração precisa já está nos campos, e o script abaixo tira o
               `required` enquanto esse assunto estiver escolhido, e mostra o
               "(opcional)" do rótulo. -->
          <div class="campo campo--largo">
            <label for="f-mensagem">Mensagem <span class="opcional">(opcional)</span></label>
            <textarea id="f-mensagem" name="mensagem" rows="4" required></textarea>
          </div>
        </div>

        <button type="submit" class="btn btn-primary form-enviar">
          <Icon name="send" size={18} /> Enviar pedido
        </button>

        <p class="form-rodape">
          Usamos o que você escrever só para responder ao seu pedido. Não publicamos nem
          repassamos seus dados.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  // Os campos escondidos por CSS continuam no formulário e vão vazios no envio:
  // o e-mail da Netlify chegava com "Estado:", "Cidade:", "Quantas pessoas:"
  // em branco num pedido que nem era de livro. Na hora de enviar, desliga o que
  // não está à vista — campo `disabled` não é enviado. Sem JavaScript, o envio
  // segue como antes, só mais comprido.
  document.querySelectorAll<HTMLFormElement>('form[data-netlify]').forEach((form) => {
    // Mensagem opcional só na shahada. Sem JavaScript continua obrigatória em
    // todos os assuntos — é o lado seguro de falhar.
    const mensagem = form.querySelector<HTMLTextAreaElement>('#f-mensagem');
    const assuntos = form.querySelectorAll<HTMLInputElement>('input[name="assunto"]');
    const ajustarMensagem = () => {
      if (!mensagem) return;
      const opcional = Boolean(form.querySelector<HTMLInputElement>('#tipo-shahada')?.checked);
      mensagem.required = !opcional;
      // O "(opcional)" do rótulo acompanha o `required`: nunca um sem o outro.
      mensagem.closest('.campo')?.classList.toggle('mensagem-opcional', opcional);
    };
    assuntos.forEach((r) => r.addEventListener('change', ajustarMensagem));
    ajustarMensagem();

    form.addEventListener('submit', () => {
      form.querySelectorAll<HTMLElement>('.campo').forEach((bloco) => {
        if (getComputedStyle(bloco).display !== 'none') return;
        bloco.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach((c) => {
          c.disabled = true;
        });
      });
      // Os radios de entrega ficam fora do bloco que os mostra; só fazem
      // sentido no pedido de livros.
      const livros = form.querySelector<HTMLInputElement>('#tipo-livros');
      if (livros && !livros.checked) {
        form.querySelectorAll<HTMLInputElement>('input[name="entrega"]').forEach((r) => {
          r.disabled = true;
        });
      }
      // Idem para os radios da shahada — e os de "onde" só valem quando a
      // shahada já foi feita.
      const shahada = form.querySelector<HTMLInputElement>('#tipo-shahada');
      const feita = form.querySelector<HTMLInputElement>('#shahada-feita');
      if (shahada && !shahada.checked) {
        form.querySelectorAll<HTMLInputElement>('input[name="shahada"]').forEach((r) => {
          r.disabled = true;
        });
      }
      if (!(shahada?.checked && feita?.checked)) {
        form.querySelectorAll<HTMLInputElement>('input[name="shahada_onde"]').forEach((r) => {
          r.disabled = true;
        });
      }
    });
  });
</script>

<style>
  .pedidos {
    background: var(--branco);
    border-block: 1px solid var(--borda);
  }

  .ped-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* ---------- Coluna explicativa ---------- */
  .ped-info {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--areia);
    border: 1px solid var(--borda);
  }

  .ped-info h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .ped-h3 {
    margin-top: 1.5rem;
  }

  .ped-info ol {
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--texto-suave);
  }

  .ped-note {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--texto-suave);
  }

  .ped-estados {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .ped-estados li {
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(4, 69, 4, 0.08);
    color: var(--verde);
  }

  /* ---------- Formulário ---------- */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-pergunta {
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  /* Quatro cartões: em duas colunas cada um ainda tem duas linhas de texto
     legíveis. Em quatro, o rótulo quebrava palavra por palavra. */
  .tipo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .tipo-card {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--borda);
    border-radius: var(--radius);
    background: var(--areia);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .tipo-card:hover {
    border-color: var(--verde-claro);
  }

  .tipo-card :global(svg) {
    color: var(--texto-suave);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .tipo-card span {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .tipo-card strong {
    font-size: 0.875rem;
  }

  .tipo-card small {
    font-size: 0.75rem;
    color: var(--texto-suave);
  }

  /* O radio escolhido pinta o cartão correspondente... */
  #tipo-livros:checked ~ .tipo-grid label[for='tipo-livros'],
  #tipo-visita:checked ~ .tipo-grid label[for='tipo-visita'],
  #tipo-shahada:checked ~ .tipo-grid label[for='tipo-shahada'],
  #tipo-outro:checked ~ .tipo-grid label[for='tipo-outro'] {
    border-color: var(--verde);
    background: #f2f7f2;
    box-shadow: inset 0 0 0 1px var(--verde);
  }

  #tipo-livros:checked ~ .tipo-grid label[for='tipo-livros'] :global(svg),
  #tipo-visita:checked ~ .tipo-grid label[for='tipo-visita'] :global(svg),
  #tipo-shahada:checked ~ .tipo-grid label[for='tipo-shahada'] :global(svg),
  #tipo-outro:checked ~ .tipo-grid label[for='tipo-outro'] :global(svg) {
    color: var(--verde);
  }

  /* Foco do teclado: o radio é invisível, então o anel vai no cartão. */
  #tipo-livros:focus-visible ~ .tipo-grid label[for='tipo-livros'],
  #tipo-visita:focus-visible ~ .tipo-grid label[for='tipo-visita'],
  #tipo-shahada:focus-visible ~ .tipo-grid label[for='tipo-shahada'],
  #tipo-outro:focus-visible ~ .tipo-grid label[for='tipo-outro'] {
    outline: 3px solid var(--dourado);
    outline-offset: 2px;
  }

  .campos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .campo--largo {
    grid-column: 1 / -1;
  }

  /* Mostra só os campos do assunto escolhido.
     Estas regras vêm DEPOIS de `.campo` de propósito: `.campo` também define
     `display`, e com a mesma especificidade quem vem por último ganha. Por isso
     `.campos .so-x` (duas classes) — assim nenhuma regra posterior de `.campo`
     volta a revelar um campo escondido. */
  .campos .so-livros,
  .campos .so-visita,
  .campos .so-shahada,
  .campos .so-outro {
    display: none;
  }

  #tipo-livros:checked ~ .campos .so-livros,
  #tipo-visita:checked ~ .campos .so-visita,
  #tipo-shahada:checked ~ .campos .so-shahada,
  #tipo-outro:checked ~ .campos .so-outro {
    display: flex;
  }

  /* Endereço só faz sentido quando o livro vai pelo correio. */
  #entrega-retirar:checked ~ .campos .so-correio {
    display: none;
  }

  /* "Onde e quando" só para quem já fez a shahada. Vem depois da regra que
     mostra `.so-shahada`, pela mesma razão de sempre: mesma especificidade,
     ganha quem vem por último. */
  #tipo-shahada:checked ~ .campos .so-feita {
    display: none;
  }

  /* Os dois radios na cadeia: só "já fiz" marcado, com outro assunto aberto,
     não pode revelar o campo. */
  #tipo-shahada:checked ~ #shahada-feita:checked ~ .campos .so-feita {
    display: flex;
  }

  /* "Qual lugar" só em outro lugar. Três radios na cadeia. */
  #tipo-shahada:checked ~ #shahada-feita:checked ~ .campos .so-onde-outro {
    display: none;
  }

  #tipo-shahada:checked ~ #shahada-feita:checked ~ #onde-outro:checked ~ .campos .so-onde-outro {
    display: flex;
  }

  .rotulo-grupo {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .entrega-opcoes {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.35rem;
  }

  .entrega-opcoes label {
    flex: 1;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--borda);
    border-radius: 12px;
    background: var(--branco);
    font-size: 0.9rem;
    font-weight: 500;
    text-align: center;
    cursor: pointer;
  }

  #entrega-correio:checked ~ .campos label[for='entrega-correio'],
  #entrega-retirar:checked ~ .campos label[for='entrega-retirar'],
  #shahada-fazer:checked ~ .campos label[for='shahada-fazer'],
  #shahada-feita:checked ~ .campos label[for='shahada-feita'],
  #onde-centro:checked ~ .campos label[for='onde-centro'],
  #onde-outro:checked ~ .campos label[for='onde-outro'] {
