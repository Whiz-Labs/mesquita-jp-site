---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrayerTimes from '../components/PrayerTimes.astro';
import Formulario from '../components/Formulario.astro';
import Documentos from '../components/Documentos.astro';
import Galeria from '../components/Galeria.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import {
  site,
  contact,
  canalPrincipal,
  activities,
  donations,
  location,
  openingHours,
  books,
} from '../config';

const pageTitle = `${site.name} — Mesquita em João Pessoa (PB)`;
const { street, district, city, state, zip } = contact.address;

// O endereço por extenso ainda não foi confirmado (só o ponto no mapa). Enquanto
// `street` estiver vazio o site diz isso em vez de imprimir um endereço meio
// preenchido.
const temEndereco = Boolean(street);
const fullAddress = [street, district, `${city} — ${state}`, zip]
  .filter(Boolean)
  .join(', ');

const atalhos = [
  {
    href: '#horarios',
    icon: 'clock',
    label: 'Quando abrimos',
    hint: 'Sexta e sábado, 11h30–13h00',
  },
  {
    href: '#pedidos',
    icon: 'book',
    label: 'Pedir livros islâmicos',
    hint: `Envio para o ${books.regionLabel}`,
  },
  { href: '#documentos', icon: 'file', label: 'Documentos', hint: 'Modelos e guias' },
];
---

<BaseLayout title={pageTitle}>
  <Header />

  <main id="conteudo">
    <!-- ================= HERO ================= -->
    <section class="hero">
      <div class="hero-pattern" aria-hidden="true"></div>
      <div class="container hero-inner">
        <div class="hero-emblema">
          <Logo
            size={132}
            sizeCss="clamp(60px, 13vh, 150px)"
            tone="branco"
            decorative={false}
          />
        </div>

        <p class="ar bismillah">بِسْمِ ٱللَّٰهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ</p>
        <h1>{site.fullName}</h1>
        <p class="hero-sub">{site.tagline}</p>

        <!-- Um botão só. O de "ver horários" apontava para #horarios, exatamente
             como o primeiro atalho logo abaixo — e o atalho ainda diz o horário
             por extenso, o que o botão não fazia. Chegar até aqui é a única
             ação da primeira tela que nenhum outro elemento cobre. -->
        <div class="hero-cta">
          <a href={contact.mapsLink} class="btn btn-gold" target="_blank" rel="noopener">
            <Icon name="pin" size={18} /> Como chegar
          </a>
        </div>

        <p class="hero-note">
          Todos são bem-vindos — muçulmanos e não muçulmanos, moradores e visitantes.
        </p>
      </div>

      <!-- Os atalhos moram DENTRO do hero: é o que faz a primeira tela ter
           altura exata (ver `.hero`) e o que os deixa parecendo parte do
           verde, e não uma faixa colada embaixo. -->
      <nav class="atalhos" aria-label="Atalhos">
        <div class="container atalhos-grid">
          {
            atalhos.map((a) => (
              <a href={a.href} class="atalho">
                <span class="atalho-icon">
                  <Icon name={a.icon} size={20} />
                </span>
                <span>
                  <strong>{a.label}</strong>
                  <small>{a.hint}</small>
                </span>
                <Icon name="arrow" size={18} class="atalho-seta" />
              </a>
            ))
          }
        </div>
      </nav>
    </section>

    <!-- ================= HORÁRIOS ================= -->
    <PrayerTimes />

    <!-- ================= SOBRE ================= -->
    <section id="sobre" class="section">
      <div class="container sobre-grid">
        <div>
          <span class="eyebrow">Sobre nós</span>
          <h2>Uma casa de Allah em João Pessoa</h2>
          <p>
            O {site.name} é o ponto de encontro dos muçulmanos da capital paraibana e de
            quem está de passagem. A comunidade se reúne para a jumu'ah na sexta-feira e
            também no sábado, no mesmo horário.
          </p>
          <p>
            Somos poucos e a mesquita não fica aberta o dia inteiro — por isso o site
            traz os horários de abertura logo no começo. Fora deles, o caminho é o
            formulário ou o Instagram: a gente responde.
          </p>

          <!-- TODO: substituir por texto/histórico real fornecido pela administração
               (quando o centro foi fundado, quem faz parte, o que já organizou). -->

          <ul class="sobre-list">
            <li>
              <Icon name="clock" size={18} /> Aberta sexta e sábado, das 11h30 às 13h00
            </li>
            <li>
              <Icon name="book" size={18} /> Envio de livros islâmicos para o {
                books.regionLabel
              }
            </li>
            <li><Icon name="compass" size={18} /> Qibla a {location.qiblaDegrees}° do norte</li>
            <li>
              <Icon name="users" size={18} /> Visitas de escolas e grupos mediante agendamento
            </li>
          </ul>
        </div>

        <aside class="sobre-card">
          <blockquote>
            <p class="ar">إِنَّمَا يَعْمُرُ مَسَاجِدَ ٱللَّهِ مَنْ ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْـَٔاخِرِ</p>
            <p class="quote-pt">
              “Só cuidam das mesquitas de Allah aqueles que creem em Allah e no Último
              Dia.”
            </p>
            <cite>Alcorão 9:18</cite>
          </blockquote>
        </aside>
      </div>
    </section>

    <!-- ================= ATIVIDADES ================= -->
    <section id="atividades" class="section atividades">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">O que acontece aqui</span>
          <h2>O que a comunidade faz</h2>
          <p>
            Além da sexta e do sábado, a comunidade se reúne nas datas do calendário
            islâmico — Ramadan e as duas festas de Eid. Como essas datas mudam todo ano,
            elas são anunciadas antes no Instagram.
          </p>
        </div>

        <div class="cards">
          {
            activities.map((a) => (
              <article class="card">
                <span class="card-icon">
                  <Icon name={a.icon} size={22} />
                </span>
                <h3>{a.title}</h3>
                <p>{a.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================= LIVROS E PEDIDOS ================= -->
    <Formulario />

    <!-- ================= DOCUMENTOS ================= -->
    <Documentos />

    <!-- ================= GALERIA ================= -->
    <Galeria />

    <!-- ================= LOCALIZAÇÃO ================= -->
    <section id="localizacao" class="section localizacao">
      <div class="container loc-grid">
        <div>
          <span class="eyebrow">Localização</span>
          <h2>Onde estamos</h2>
          {
            temEndereco ? (
              <p class="loc-address">{fullAddress}</p>
            ) : (
              <p class="loc-address">
                {city} — {state}
                <span class="loc-address-nota">
                  O endereço por extenso está sendo confirmado. O ponto no mapa ao lado é
                  o da mesquita — use o botão abaixo para traçar a rota.
                </span>
              </p>
            )
          }
          <p class="loc-help">
            A mesquita abre {openingHours.days.map((d) => d.day.toLowerCase()).join(' e ')},
            das 11h30 às 13h00. Chegue com alguma antecedência na sexta — é o dia de maior
            movimento.
          </p>
          <div class="loc-actions">
            <a href={contact.mapsLink} class="btn btn-primary" target="_blank" rel="noopener">
              <Icon name="pin" size={18} /> Abrir no Google Maps
            </a>
            <a href={canalPrincipal.href} class="btn btn-ghost" target="_blank" rel="noopener">
              <Icon name={canalPrincipal.icon} size={18} /> Tirar dúvida no {
                canalPrincipal.nome
              }
            </a>
          </div>
        </div>

        <!-- O iframe só entra quando `contact.mapsEmbed` for preenchido
             (Maps → Compartilhar → Incorporar um mapa → copiar o src). -->
        <div class="loc-map">
          {
            contact.mapsEmbed ? (
              <iframe
                src={contact.mapsEmbed}
                title={`Mapa — ${site.name}`}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            ) : (
              <div class="loc-map-placeholder">
                <Icon name="pin" size={28} />
                <p>O mapa entra aqui quando o endereço for confirmado.</p>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- ================= DOAÇÕES ================= -->
    <section id="doacoes" class="section doacoes">
      <div class="container doa-inner">
        <div>
          <span class="eyebrow">Sadaqa</span>
          <h2>Apoie a mesquita</h2>
          <p>{donations.note}</p>
          {
            donations.pixKey && (
              <p class="doa-pix">
                <strong>PIX:</strong> <code>{donations.pixKey}</code>
                {donations.pixOwner && <span> · {donations.pixOwner}</span>}
              </p>
            )
          }
        </div>
        <a href={canalPrincipal.href} class="btn btn-primary" target="_blank" rel="noopener">
          <Icon name="heart" size={18} /> Quero contribuir
        </a>
      </div>
    </section>

    <!-- ================= CONTATO ================= -->
    <section id="contato" class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Contato</span>
          <h2>Fale com a gente</h2>
          <p>
            Dúvidas sobre o Islam, pedido de visita, casamento, funeral ou aulas — escreva
            sem cerimônia. O jeito mais rápido de falar com o centro é pelo Instagram: é
            lá que a gente responde e avisa a programação.
          </p>
        </div>

        <div class="contato-grid">
          <a
            class="contato-item contato-item--destaque"
            href={contact.instagram}
            target="_blank"
            rel="noopener"
          >
            <Icon name="instagram" size={20} />
            <span>
              <strong>Instagram — fale por aqui</strong>
              {contact.instagramHandle}
            </span>
          </a>

          <a class="contato-item" href={contact.mapsLink} target="_blank" rel="noopener">
            <Icon name="pin" size={20} />
            <span>
              <strong>Como chegar</strong>
              {temEndereco ? `${street}, ${city}/${state}` : `Ver no Google Maps — ${city}/${state}`}
            </span>
          </a>

          {
            contact.whatsapp && (
              <a class="contato-item" href={contact.whatsapp} target="_blank" rel="noopener">
                <Icon name="phone" size={20} />
                <span>
                  <strong>WhatsApp</strong>
                  {contact.phone}
                </span>
              </a>
            )
          }

          {
            contact.email && (
              <a class="contato-item" href={`mailto:${contact.email}`}>
                <Icon name="mail" size={20} />
                <span>
                  <strong>E-mail</strong>
                  {contact.email}
                </span>
              </a>
            )
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(165deg, var(--verde-medio) 0%, var(--verde-escuro) 100%);
    color: #fff;
    /*
     * A primeira tela é uma composição só: cabeçalho + hero (com os atalhos
     * dentro), sem rolagem e sem sobra, em qualquer altura de tela.
     *
     * Os atalhos estarem DENTRO do hero é o que torna a conta exata: antes a
     * altura da faixa era um palpite em `rem` subtraído aqui, e todo erro de
     * palpite virava um pedaço da próxima seção aparecendo na dobra. Agora só
     * o cabeçalho é subtraído, e ele tem altura fixa.
     *
     * - em tela alta o hero ESTICA e o conteúdo fica centrado, com os atalhos
     *   apoiados na base — o verde preenche a dobra inteira;
     * - em tela baixa ele encolhe até o conteúdo, e os espaçamentos internos
     *   (todos com um termo em `vh`) apertam junto.
     *
     * `min-height`, não `height`: se um dia o conteúdo crescer além da conta,
     * ele transborda para baixo em vez de ser cortado. `svh` é a altura da
     * tela com a barra do navegador móvel ABERTA — com `vh` o celular
     * calcularia por cima dela e os atalhos ficariam escondidos.
     */
    min-height: calc(100vh - var(--altura-topo));
    min-height: calc(100svh - var(--altura-topo));
    display: flex;
    flex-direction: column;
    /*
     * O padding de baixo cai EMBAIXO da faixa de atalhos (ela está fora da
     * área centrada), então é só a folga da faixa até a dobra. Já o de cima
     * entra direto no respiro do conteúdo: cada pixel aqui é um pixel a mais
     * em cima e um a menos embaixo. Ele existe, e é regulado mais abaixo em
     * `min-height: 760px` — o respiro de cima é a margem da composição, o de
     * baixo é o intervalo entre dois grupos, e intervalo interno maior que
     * margem externa faz os atalhos parecerem soltos.
     */
    padding-top: 0;
    padding-bottom: clamp(0.5rem, 1.5vh, 1rem);
    text-align: center;
  }

  /* Ocupa a sobra e centraliza o conteúdo nela; os atalhos ficam com a altura
     que pedirem, encostados na base. */
  .hero-inner {
    position: relative; /* acima de .hero-pattern */
    flex: 1;
    display: grid;
    align-content: center;
  }

  /* Padrão geométrico discreto, feito só com gradientes — sem imagem. */
  .hero-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    background-image:
      repeating-linear-gradient(45deg, transparent 0 22px, rgba(233, 198, 75, 0.5) 22px 23px),
      repeating-linear-gradient(-45deg, transparent 0 22px, rgba(233, 198, 75, 0.5) 22px 23px);
    mask-image: radial-gradient(circle at 50% 38%, #000 8%, transparent 70%);
  }


  /* Halo dourado atrás do emblema — o mesmo anel que ele já tem no logo. */
  .hero-emblema {
    display: flex;
    justify-content: center;
    margin-bottom: clamp(0.75rem, 1.6vh, 1.25rem);
  }

  .hero-emblema :global(img) {
    box-shadow:
      0 0 0 1px rgba(233, 198, 75, 0.45),
      0 0 0 10px rgba(233, 198, 75, 0.07),
      0 18px 40px rgba(0, 0, 0, 0.3);
  }

  .bismillah {
    font-size: clamp(1.1rem, 2.8vw, 1.5rem);
    color: var(--dourado-claro);
    margin-bottom: clamp(0.6rem, 1.4vh, 1rem);
  }

  /* `balance` reparte as linhas em vez de encher a primeira e deixar a sobra
     na última — sem ele o título quebrava em "Centro Islâmico de João /
     Pessoa", partindo o nome da cidade ao meio, e a linha de apoio terminava
     num "da Paraíba." solitário. */
  .hero h1 {
    font-size: clamp(1.6rem, 4.6vw, 2.75rem);
    max-width: 22ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  .hero-sub {
    max-width: 46ch;
    margin: clamp(0.6rem, 1.4vh, 1rem) auto 0;
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    color: rgba(255, 255, 255, 0.85);
    text-wrap: balance;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1rem, 2.2vh, 1.75rem);
  }

  .hero .btn-ghost {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .hero .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.6);
  }

  .hero-note {
    margin-top: clamp(0.8rem, 1.6vh, 1.25rem);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
  }

  /*
   * Numa tela baixa quem manda nos `clamp` acima já não é o termo em `vh` — é
   * o piso. Então aqui o piso desce também, senão um celular pequeno (~640px
   * de altura) estoura a dobra por umas poucas dezenas de pixels e a faixa de
   * atalhos some. Vale para celular em pé e para notebook curto.
   */
  /* Só onde há folga de sobra. Numa tela baixa este padding não teria espaço
     para sair de lugar nenhum: empurraria o conteúdo para fora da dobra. */
  @media (min-height: 760px) {
    .hero {
      padding-top: clamp(1.5rem, 5vh, 4.5rem);
    }

    /* Numa tela alta o bloco respira por dentro. Sem isto o ritmo interno
       fica travado no mesmo aperto do celular e toda a altura sobrando vai
       parar nas bordas — o conteúdo parece uma ilha pequena no meio do verde.
       Distribuir o ar DENTRO da composição é o que a faz ocupar a tela. */
    .hero-emblema {
      margin-bottom: clamp(1rem, 2.5vh, 2rem);
    }

    .bismillah {
      margin-bottom: clamp(0.9rem, 2.5vh, 1.75rem);
    }

    .hero-sub {
      margin-top: clamp(0.9rem, 2.5vh, 1.75rem);
    }

    .hero-cta {
      margin-top: clamp(1.5rem, 4vh, 3rem);
    }

    .hero-note {
      margin-top: clamp(1rem, 3vh, 2.25rem);
    }
  }

  @media (max-height: 700px) {
    /* Recupera o que o emblema maior custou aqui em cima. */
    .atalhos-grid {
      padding-block: 0.75rem;
    }

    .bismillah {
      font-size: 1rem;
    }

    .hero h1 {
      font-size: clamp(1.4rem, 4.2vw, 2rem);
    }

    .hero-note {
      margin-top: 0.5rem;
      font-size: 0.8125rem;
    }
  }

  /* ---------- Atalhos ---------- */
  /* Vidro sobre o verde: fundo branco quase transparente e fio dourado, os
     mesmos dois materiais do emblema e dos botões do hero. Nada de cartão
     branco opaco aqui — ele recortaria a faixa do resto do bloco, que é
     exatamente o que se queria evitar. */
  .atalhos {
    position: relative; /* acima de .hero-pattern */
    flex-shrink: 0;
  }

  /* Sempre três colunas, em qualquer largura: esta faixa fecha a primeira
     tela, e empilhar os três cartões a tornaria três vezes mais alta do que a
     dobra comporta. O que muda no celular é a forma do cartão, não a grade. */
  .atalhos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding-block: 1.25rem;
  }

  .atalho {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1.15rem;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(233, 198, 75, 0.28);
    color: #fff;
    transition: background-color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .atalho:hover {
    text-decoration: none;
    background: rgba(255, 255, 255, 0.13);
    border-color: var(--dourado-claro);
    transform: translateY(-2px);
  }

  .atalho-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 10px;
    background: rgba(233, 198, 75, 0.14);
    color: var(--dourado-claro);
  }

  .atalho span:not(.atalho-icon) {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .atalho strong {
    font-size: 0.9375rem;
  }

  .atalho small {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .atalho :global(.atalho-seta) {
    margin-left: auto;
    color: var(--dourado-claro);
    flex-shrink: 0;
  }

  /* ---------- Sobre ---------- */
  .sobre-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .sobre-grid h2 {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
    margin-bottom: 1rem;
  }

  .sobre-grid p {
    color: var(--texto-suave);
    margin-bottom: 1rem;
  }

  .sobre-list {
    list-style: none;
    margin-top: 1.5rem;
    display: grid;
    gap: 0.7rem;
  }

  .sobre-list li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.9375rem;
  }

  .sobre-list :global(svg) {
    color: var(--dourado-escuro);
    flex-shrink: 0;
  }

  .sobre-card {
    position: relative;
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  /* Fio dourado no topo do cartão, ecoando o anel do emblema. */
  .sobre-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(90deg, var(--dourado), var(--dourado-claro));
  }

  .sobre-card .ar {
    font-size: 1.4rem;
    color: var(--verde);
    margin-bottom: 0.9rem;
  }

  .quote-pt {
    color: var(--texto) !important;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .sobre-card cite {
    display: block;
    margin-top: 0.6rem;
    font-style: normal;
    font-size: 0.875rem;
    color: var(--dourado-escuro);
    font-weight: 700;
  }

  /* ---------- Atividades ---------- */
  .atividades {
    background: var(--areia-escura);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.15rem;
  }

  .card {
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    background: rgba(4, 69, 4, 0.08);
    color: var(--verde);
    margin-bottom: 1rem;
  }

  .card h3 {
    font-size: 1.0625rem;
    margin-bottom: 0.4rem;
  }

  .card p {
