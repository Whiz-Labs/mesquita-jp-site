# Copie para .env e preencha. Só é usado NO BUILD: a seção de prestação de
# contas é lida da Supabase quando o site é gerado, e sai gravada no HTML.
# Nenhuma dessas variáveis chega ao navegador.
#
# Na Netlify: Site configuration → Environment variables.

# https://<ref>.supabase.co
SUPABASE_URL=

# Chave PUBLICÁVEL (anon). Nunca a secreta: aqui só se lê, e o RLS já limita a
# leitura a lançamento publicado e necessidade ativa.
PUBLIC_SUPABASE_ANON_KEY=
